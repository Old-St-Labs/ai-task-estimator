{
  "name": "task-estimator-api-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/task-estimator/task-estimator-api-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/task-estimator/task-estimator-api-service",
        "main": "apps/task-estimator/task-estimator-api-service/src/main.ts",
        "tsConfig": "apps/task-estimator/task-estimator-api-service/tsconfig.app.json",
        "assets": ["apps/task-estimator/task-estimator-api-service/src/assets"],
        "generatePackageJson": true,
        "webpackConfig": "apps/task-estimator/task-estimator-api-service/webpack.config.js"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "build-serverless-files": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "dist/apps/task-estimator/task-estimator-api-service",
        "commands": [{ "command": "yarn add tslib" }],
        "parallel": false
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": { "buildTarget": "task-estimator-api-service:build", "runBuildTargetDependencies": false },
      "configurations": {
        "development": { "buildTarget": "task-estimator-api-service:build:development" },
        "production": { "buildTarget": "task-estimator-api-service:build:production" }
      }
    }
  }
}
